TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs allowed to approve/reject orders.
ADMIN_TELEGRAM_IDS=
OWNER_TELEGRAM_ID=
# Numeric -100... ID of the trusted AuriX group. Used only for safe staff
# bootstrap/group-sync previews; never infer a control group from messages.
AURIX_CONTROL_GROUP_ID=
# Optional one-time comma-separated IDs whose old Telegram command scopes must be deleted.
ADMIN_SCOPE_CLEANUP_IDS=
# Optional comma-separated numeric Telegram IDs for legacy staging-only claim restriction.
# Leave empty for public daily 300 MiB and monthly 3 GiB claims.
TRIAL_TELEGRAM_IDS=
OUTLINE_API_URL=https://outline.example.com:12345/SecretPath
OUTLINE_CERT_SHA256=
# Bound an unreachable endpoint so one failed fleet node cannot stall a bot
# command or maintenance pass for the transport's historical 15-second default.
OUTLINE_REQUEST_TIMEOUT_SECONDS=5
# After a transport failure, fail fast until this cooldown expires; a later
# probe automatically closes the circuit when the endpoint recovers.
OUTLINE_CIRCUIT_BREAKER_SECONDS=60
# Optional multi-server replacement for the two variables above. Keep this
# JSON entirely in the server environment; management URLs are credentials.
# OUTLINE_SERVERS_JSON='[{"id":"sg1","label":"Singapore 1","api_url":"https://host:port/SecretPath","cert_sha256":"64-hex-digest"}]'
# OUTLINE_DEFAULT_SERVER_ID=sg1
# New issuance requires a healthy inventory snapshot newer than this age.
AURIX_SERVER_HEALTH_MAX_AGE_SECONDS=900
# Generate once with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AURIX_ACCESS_URL_KEY=
DATABASE_PATH=data/bot.db
# Storage profile: disk (default) or postgres. The free Render profile sets postgres.
AURIX_STORAGE_MODE=disk
# Optional hosted commercial-state backend. Required when AURIX_STORAGE_MODE=postgres.
COMMERCE_DATABASE_URL=
# Private Supabase Storage bucket for payment receipt evidence. Never use the
# publishable/anon key here; this is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=payment-receipts
RECEIPT_STORAGE_REQUIRED=0
# Optional OpenAI-compatible vision endpoint for receipt parsing. The model only
# extracts candidate fields; staff verification remains mandatory.
# Antigravity proxy example: https://your-gateway.example/v1 with a model such
# as antigravity/<vision-model-id>. Use the gateway API key, never an OAuth token.
RECEIPT_LLM_BASE_URL=
RECEIPT_LLM_MODEL=
RECEIPT_LLM_API_KEY=
# Optional comma-separated failover routes using the same authenticated gateway.
RECEIPT_LLM_FALLBACK_MODELS=
# Selection policy: first_acceptable is lowest-cost; rank_all compares every
# configured model; consensus requires two agreeing acceptable models and sends
# disagreements to manual review. The latter two can use more provider quota.
RECEIPT_LLM_SELECTION_MODE=first_acceptable
# Required for safe AI triage. Values remain server-side and are masked in all
# admin diagnostics. Use provider keys kbzpay,wavepay,ayapay,uabpay,cbpay.
PAYMENT_RECIPIENTS_JSON='{"kbzpay":{"names":[],"accounts":[]},"wavepay":{"names":[],"accounts":[]},"ayapay":{"names":[],"accounts":[]},"uabpay":{"names":[],"accounts":[]},"cbpay":{"names":[],"accounts":[]}}'
# Keep false for screenshot-only payment evidence in the public MVP.
ALLOW_TEXT_PAYMENT_REFERENCES=0
# Housekeeping runs independently from Telegram polling on this interval.
AURIX_MAINTENANCE_INTERVAL_SECONDS=60
# Temporary diagnostics: logs Telegram, Outline, Supabase Storage, Postgres,
# handler, and maintenance timings without logging payloads or credentials.
AURIX_LATENCY_LOG=0

# Optional separate infrastructure-worker settings. The Telegram bot does not
# execute provider mutations. Keep disabled until budget/operator approval.
DIGITALOCEAN_API_TOKEN=
AURIX_INFRASTRUCTURE_MUTATIONS_ENABLED=0
AURIX_ALLOWED_REGIONS=sgp1
AURIX_ALLOWED_DROPLET_SIZES=s-1vcpu-1gb
AURIX_ALLOWED_DROPLET_IMAGES=ubuntu-24-04-x64
AURIX_MAX_VPN_NODES=3
AURIX_MAX_NODE_CREATIONS_PER_DAY=1
AURIX_NODE_CREATION_COOLDOWN_SECONDS=86400
# Final MVP envelope: at most three $6 nodes ($18/month). This is only a
# ceiling; keep mutations disabled until a separately scoped token is approved.
AURIX_MAX_MONTHLY_INFRA_BUDGET_USD=18
AURIX_DROPLET_MONTHLY_COST_ESTIMATE_USD=6
AURIX_SCALE_PREPARE_UTILIZATION_PERCENT=75
AURIX_SCALE_URGENT_UTILIZATION_PERCENT=90

# Declarative endpoint fleet. This is the single source of truth used by the
# provider-neutral reconciler after a VM exists. Management API secrets are
# discovered over pinned SSH and written to OUTLINE_SERVERS_JSON automatically.
AURIX_FLEET_NODES_JSON=[]
AURIX_FLEET_SSH_KEY=/etc/aurix-fleet/automation_ed25519
AURIX_FLEET_KNOWN_HOSTS=/etc/aurix-fleet/known_hosts
# Optional portable recovery copies. Base64 is encoding, not encryption; these
# belong only in the private .env/offline secret backup, never Git or CI.
AURIX_FLEET_SSH_PRIVATE_KEY_B64=
AURIX_FLEET_KNOWN_HOSTS_B64=
AURIX_FLEET_CONTROL_PLANE_SOURCE=
AURIX_FLEET_ENV_FILE=/etc/aurix-bot/aurix.env
AURIX_FLEET_LOCK_FILE=/run/aurix-fleet-reconcile.lock
AURIX_FLEET_REVISION=production
# Enable after the existing manifest has been normalized: plan+tier slots must
# fit max_keys minus reserved_keys. Leave 0 during a compatibility migration.
AURIX_FLEET_STRICT_ALLOCATION_VALIDATION=0
AURIX_OUTLINE_INSTALLER_URL=https://raw.githubusercontent.com/OutlineFoundation/outline-server/de566bfc9ff4429ae839e304b4d7e03b703ce415/src/server_manager/install_scripts/install_server.sh
AURIX_OUTLINE_INSTALLER_SHA256=6cadc866cf901beb89473e61ab9ca7c63fac56b7d614be6c592b25a1465fa0d2
# Generate once with Fernet.generate_key(); loss of this secret makes encrypted
# node-state backups unrecoverable. Store an offline copy outside the VM.
AURIX_FLEET_BACKUP_KEY=
AURIX_FLEET_BACKUP_DIR=/var/lib/aurix-fleet/backups
AURIX_FLEET_BACKUP_RETENTION=14
AURIX_FLEET_BACKUP_MAX_MB=256
# Optional mounted or synced offsite backup root. Set REQUIRE_OFFSITE=1 in
# production once this path is backed by private object storage or another VM.
AURIX_FLEET_BACKUP_OFFSITE_DIR=
AURIX_FLEET_BACKUP_OFFSITE_RETENTION=30
AURIX_FLEET_BACKUP_REQUIRE_OFFSITE=0
# Required for disaster recovery when DATABASE_PATH is SQLite. Prefer hosted
# PostgreSQL for production; otherwise mirror encrypted SQLite backups off-box.
AURIX_DATABASE_BACKUP_KEY=
AURIX_DATABASE_BACKUP_DIR=/var/lib/aurix-bot/db-backups
AURIX_DATABASE_BACKUP_OFFSITE_DIR=
AURIX_DATABASE_BACKUP_OFFSITE_RETENTION=30
AURIX_DATABASE_BACKUP_REQUIRE_OFFSITE=0
# Preferred offsite mode for no-manual recovery. Works with S3-compatible
# storage such as Cloudflare R2, Backblaze B2 S3, DigitalOcean Spaces, or AWS.
# When configured, this replaces the *_OFFSITE_DIR filesystem mirror paths.
AURIX_BACKUP_OBJECT_STORE_URL=
AURIX_BACKUP_OBJECT_STORE_ENDPOINT=
AURIX_BACKUP_OBJECT_STORE_REGION=auto
AURIX_BACKUP_OBJECT_STORE_ACCESS_KEY_ID=
AURIX_BACKUP_OBJECT_STORE_SECRET_ACCESS_KEY=
# Alternative offsite backend using the existing Supabase Storage service-role
# credential. Keep this bucket private and distinct from SUPABASE_RECEIPTS_BUCKET.
# Set either the S3-compatible variables above or this Supabase block, never both.
AURIX_BACKUP_SUPABASE_BUCKET=
AURIX_BACKUP_SUPABASE_PREFIX=
AURIX_BACKUP_STORAGE_TIMEOUT_SECONDS=45
AURIX_BACKUP_STORAGE_MAX_MB=512
# Optional stable endpoint DNS automation. Cloudflare API tokens need Zone DNS
# Edit permission for the selected zone. Use DNS-only records: Outline is not
# HTTP and must not be orange-cloud proxied. Every fleet node must have a
# dns_name before DNS sync can run.
AURIX_DNS_PROVIDER=
AURIX_DNS_ZONE_ID=
AURIX_DNS_API_TOKEN=
AURIX_DNS_TTL=300
AURIX_DNS_PROXIED=0
# Set to 1 when endpoint continuity is a hard production requirement; the
# readiness audit and deploy preflight then fail if DNS is absent or invalid.
AURIX_DNS_REQUIRE=0
