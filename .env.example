TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs allowed to approve/reject orders.
ADMIN_TELEGRAM_IDS=
# Optional one-time comma-separated IDs whose old Telegram command scopes must be deleted.
ADMIN_SCOPE_CLEANUP_IDS=
# Optional comma-separated numeric Telegram IDs for legacy staging-only claim restriction.
# Leave empty for public daily 300 MiB and monthly 3 GiB claims.
TRIAL_TELEGRAM_IDS=
OUTLINE_API_URL=https://outline.example.com:12345/SecretPath
OUTLINE_CERT_SHA256=
# Generate once with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AURIX_ACCESS_URL_KEY=
DATABASE_PATH=data/bot.db
# Storage profile: disk (default) or postgres. The free Render profile sets postgres.
AURIX_STORAGE_MODE=disk
# Optional hosted commercial-state backend. Required when AURIX_STORAGE_MODE=postgres.
COMMERCE_DATABASE_URL=
# Private Supabase Storage bucket for payment receipt evidence. Never use the
# publishable/anon key here; this is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECEIPTS_BUCKET=payment-receipts
RECEIPT_STORAGE_REQUIRED=0
# Optional OpenAI-compatible vision endpoint for receipt parsing. The model only
# extracts candidate fields; staff verification remains mandatory.
RECEIPT_LLM_BASE_URL=
RECEIPT_LLM_MODEL=
RECEIPT_LLM_API_KEY=
# Telegram photo file_id or stable HTTPS URL for each payment QR. Recipient
# text is also used as a receipt-parser cross-check when configured.
PAYMENT_QR_KPAY=
PAYMENT_RECIPIENT_KPAY=
PAYMENT_QR_WAVEPAY=
PAYMENT_RECIPIENT_WAVEPAY=
PAYMENT_QR_AYAPAY=
PAYMENT_RECIPIENT_AYAPAY=
PAYMENT_QR_UABPAY=
PAYMENT_RECIPIENT_UABPAY=
PAYMENT_QR_CBPAY=
PAYMENT_RECIPIENT_CBPAY=
# Keep false for screenshot-only payment evidence in the public MVP.
ALLOW_TEXT_PAYMENT_REFERENCES=0
# Housekeeping runs independently from Telegram polling on this interval.
AURIX_MAINTENANCE_INTERVAL_SECONDS=60
# Temporary diagnostics: logs Telegram, Outline, Supabase Storage, Postgres,
# handler, and maintenance timings without logging payloads or credentials.
AURIX_LATENCY_LOG=0
# Optional HTTPS Telegram Mini App URL. Leave blank until the web service is live.
AURIX_WEB_APP_URL=
# Optional bot/support deep link used by the web portal's Help actions.
AURIX_TELEGRAM_URL=
# Web portal only: reject Mini App sessions older than this many seconds.
AURIX_WEB_APP_INIT_DATA_MAX_AGE=86400

# AuriX AI gateway. The production container calls the existing 9Router over
# the private Docker network and exposes only the controlled AuriX API.
AURIX_AI_ROUTER_BASE_URL=http://9router:20128
AURIX_AI_ROUTER_API_KEY=
# Verified route at the current 9Router deployment.
AURIX_AI_MODEL=ag/gemini-3.7-flash-high
AURIX_AI_ACCESS_TOKEN=
AURIX_AI_LEGACY_TOKEN_ENABLED=0
AURIX_AI_ALLOW_ANONYMOUS=0
AURIX_AI_TIMEOUT_SECONDS=60
AURIX_AI_MAX_OUTPUT_TOKENS=1200
AURIX_AI_MAX_REQUESTS_PER_MINUTE=20
AURIX_TELEGRAM_BOT_USERNAME=aurix_outline_vpn_bot
AURIX_AI_SESSION_MAX_AGE_SECONDS=86400

# Endpoint registry bootstrap. Existing credentials are migrated to this
# endpoint before any second server may accept allocations.
AURIX_BOOTSTRAP_ENDPOINT_CODE=SGP-01
AURIX_BOOTSTRAP_ENDPOINT_REGION=sgp1
AURIX_ENDPOINT_HEALTH_MAX_AGE_SECONDS=900

# DigitalOcean fleet controls. Provider mutations fail closed unless explicitly
# enabled after the two-node acceptance gate. Keep the token only on the
# dedicated infrastructure worker, never on VPN nodes or in cloud-init user data.
DIGITALOCEAN_API_TOKEN=
AURIX_INFRASTRUCTURE_MUTATIONS_ENABLED=0
AURIX_ENDPOINT_ACTIVATION_ENABLED=0
AURIX_ALLOWED_REGIONS=sgp1
AURIX_ALLOWED_DROPLET_SIZES=s-1vcpu-1gb
AURIX_ALLOWED_DROPLET_IMAGES=ubuntu-24-04-x64
AURIX_MAX_VPN_NODES=3
AURIX_MAX_NODE_CREATIONS_PER_DAY=2
AURIX_NODE_CREATION_COOLDOWN_SECONDS=1800
# Optional hard billing guard. Leave empty until the infrastructure worker can read billing.
AURIX_MAX_MONTHLY_INFRA_BUDGET_USD=
AURIX_DROPLET_MONTHLY_COST_ESTIMATE_USD=6
