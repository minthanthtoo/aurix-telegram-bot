# This file is safe test data for CI. Copy the fleet section into the private
# production .env and replace addresses, capacities, and key paths.
AURIX_FLEET_STRICT_ALLOCATION_VALIDATION=1
AURIX_FLEET_NODES_JSON=[{"id":"sg-a","label":"Singapore A","host":"192.0.2.10","dns_name":"sg-a.vpn.example.com","provider":"digitalocean","provider_resource_id":"123456789","region":"sgp1","api_port":61603,"keys_port":443,"max_keys":100,"reserved_keys":10,"monthly_traffic_bytes":2000000000000,"tier_slots":{"FREE300MB":20,"FREE3GB":10,"PROMO":5},"plan_slots":{"basic_50gb":40,"standard_100gb":15}},{"id":"bkk-a","label":"Bangkok A","host":"198.51.100.20","dns_name":"bkk-a.vpn.example.com","provider":"nube","region":"bkk1","api_port":61603,"keys_port":443,"max_keys":50,"reserved_keys":5,"monthly_traffic_bytes":1000000000000,"tier_slots":{"FREE300MB":10,"FREE3GB":5,"PROMO":0},"plan_slots":{"basic_50gb":20,"standard_100gb":10}}]
AURIX_FLEET_SSH_KEY=/etc/aurix-fleet/automation_ed25519
AURIX_FLEET_KNOWN_HOSTS=/etc/aurix-fleet/known_hosts
AURIX_FLEET_CONTROL_PLANE_SOURCE=203.0.113.7/32
AURIX_FLEET_BACKUP_OFFSITE_DIR=/mnt/aurix-offsite/fleet-backups
AURIX_FLEET_BACKUP_OFFSITE_RETENTION=30
AURIX_FLEET_BACKUP_REQUIRE_OFFSITE=1
# Or use a private Supabase Storage bucket (do not configure both backends).
# SUPABASE_URL= https project URL
# SUPABASE_SERVICE_ROLE_KEY= server-only key
# SUPABASE_RECEIPTS_BUCKET=payment-receipts
# AURIX_BACKUP_SUPABASE_BUCKET=aurix-recovery
# AURIX_BACKUP_SUPABASE_PREFIX=production
# AURIX_BACKUP_STORAGE_TIMEOUT_SECONDS=45
# AURIX_BACKUP_STORAGE_MAX_MB=512
AURIX_DNS_PROVIDER=cloudflare
AURIX_DNS_ZONE_ID=
AURIX_DNS_API_TOKEN=
AURIX_DNS_TTL=300
AURIX_DNS_PROXIED=0
AURIX_DNS_REQUIRE=1
