# Social/brand media policy: generated and superseded media stays local.
# Keep only the explicit canonical allowlist below in Git; update this list
# when a new final replaces an existing campaign or brand master.
assets/social/**/*.png
assets/social/**/*.jpg
assets/social/**/*.jpeg
assets/social/**/*.webp
assets/social/**/*.gif
assets/social/**/*.svg
brand/**/*.png
brand/**/*.jpg
brand/**/*.jpeg
brand/**/*.webp
brand/**/*.gif
brand/**/*.svg

