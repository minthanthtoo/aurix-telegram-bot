# AuriX Telegram bot — DigitalOcean/systemd environment template
#
# Copy this file to /etc/aurix-bot/aurix.env, replace every required
# placeholder, then chmod 0640 and chown root:aurix. Never commit the filled
# file, paste it into chat, or print it in logs.

# --- Telegram identity and staff ---
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_TELEGRAM_IDS=replace-with-owner-telegram-id
ADMIN_SCOPE_CLEANUP_IDS=
TRIAL_TELEGRAM_IDS=

# --- Outline Management API (the complete secret URL and pinned cert) ---
# Copy the full apiUrl emitted by Outline Manager, including its secret path.
OUTLINE_API_URL=https://outline.example.com:12345/SecretPath
OUTLINE_CERT_SHA256=replace-with-64-hex-sha256
# Generate once and preserve forever; this encrypts stored access URLs.
AURIX_ACCESS_URL_KEY=replace-with-persistent-fernet-key

# --- Durable bot state ---
AURIX_STORAGE_MODE=disk
DATABASE_PATH=/var/lib/aurix-bot/bot.db
# Leave empty when using the local SQLite profile. Set only when a separately
# managed PostgreSQL service is intentionally used for commerce state.
COMMERCE_DATABASE_URL=

# --- Supabase receipt evidence ---
# Create this bucket as private. The service-role key stays server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_RECEIPTS_BUCKET=payment-receipts
RECEIPT_STORAGE_REQUIRED=1

# Optional OpenAI-compatible vision extraction. Configure all three or none;
# model output is evidence only and never approves a payment automatically.
RECEIPT_LLM_BASE_URL=
RECEIPT_LLM_MODEL=
RECEIPT_LLM_API_KEY=

# --- Customer payment methods ---
# Each value can be a Telegram photo file_id or stable HTTPS image URL. Keep
# the QR and recipient pair for every method you expose.
PAYMENT_QR_KPAY=
PAYMENT_RECIPIENT_KPAY=
PAYMENT_QR_WAVEPAY=
PAYMENT_RECIPIENT_WAVEPAY=
PAYMENT_QR_AYAPAY=
PAYMENT_RECIPIENT_AYAPAY=
PAYMENT_QR_UABPAY=
PAYMENT_RECIPIENT_UABPAY=
PAYMENT_QR_CBPAY=
PAYMENT_RECIPIENT_CBPAY=
ALLOW_TEXT_PAYMENT_REFERENCES=0

# --- Runtime/UX ---
AURIX_MAINTENANCE_INTERVAL_SECONDS=60
AURIX_MAINTENANCE_HEARTBEAT_PATH=/var/lib/aurix-bot/maintenance-heartbeat.json
# Set to 1 only for the first start after upgrading an existing AuriX SQLite
# database from the previous modular release; return to 0 after reconciliation.
AURIX_ALLOW_LEGACY_MIGRATION_RECONCILE=0
AURIX_WELCOME_IMAGE=
AURIX_LATENCY_LOG=0

# --- Optional Telegram Mini App / managed-device portal ---
# Leave blank until an HTTPS portal is deployed and verified.
AURIX_WEB_APP_URL=
AURIX_TELEGRAM_URL=https://t.me/aurix_outline_vpn_bot
AURIX_WEB_APP_INIT_DATA_MAX_AGE=86400
AURIX_DEVICE_API_URL=
AURIX_DEVICE_MANIFEST_PRIVATE_KEY=
AURIX_DEVICE_MANIFEST_KEY_ID=aurix-manifest-1
AURIX_MAX_ACTIVE_DEVICES=

# --- Endpoint/fleet safety defaults (all provider mutations stay off) ---
AURIX_MANAGED_NODE_AGENTS_JSON=
DIGITALOCEAN_API_TOKEN=
AURIX_INFRASTRUCTURE_INTENTS_ENABLED=0
AURIX_INFRASTRUCTURE_MUTATIONS_ENABLED=0
AURIX_ENDPOINT_ACTIVATION_ENABLED=0
AURIX_AUTOMATIC_SCALE_ENABLED=0
AURIX_ENDPOINT_HEALTH_MAX_AGE_SECONDS=900
AURIX_USAGE_SNAPSHOT_MAX_AGE_SECONDS=1800
AURIX_ENDPOINT_DEGRADE_FAILURES=2
AURIX_ENDPOINT_RECOVER_SUCCESSES=2
AURIX_ENDPOINT_RECOVERY_COOLDOWN_SECONDS=60
AURIX_MANAGED_HEALTH_OBSERVATION_TTL_SECONDS=900
AURIX_MANAGED_SESSION_TERMINATION_BATCH=100
AURIX_ALLOWED_REGIONS=sgp1
AURIX_ALLOWED_DROPLET_SIZES=s-1vcpu-1gb
AURIX_ALLOWED_DROPLET_IMAGES=ubuntu-24-04-x64
AURIX_MAX_VPN_NODES=3
AURIX_MAX_VPN_NODES_PER_REGION=3
AURIX_MAX_NODE_CREATIONS_PER_DAY=2
AURIX_NODE_CREATION_COOLDOWN_SECONDS=1800
AURIX_SCALE_REGION=sgp1
AURIX_SCALE_PLAN_CODE=
AURIX_SCALE_WARM_BUFFER_ASSIGNMENTS=0
AURIX_MAX_MONTHLY_INFRA_BUDGET_USD=
AURIX_DROPLET_MONTHLY_COST_ESTIMATE_USD=6
# Leave blank until the exact restricted firewall policy is reviewed.
AURIX_DIGITALOCEAN_FIREWALL_POLICY_JSON=

# --- Optional AuriX AI web gateway (separate service, not needed by the bot) ---
# Configure these only for the independent aurix-ai.service/container.
AURIX_AI_ROUTER_BASE_URL=http://9router:20128
AURIX_AI_ROUTER_API_KEY=
AURIX_AI_MODEL=
AURIX_AI_ACCESS_TOKEN=
AURIX_AI_LEGACY_TOKEN_ENABLED=0
AURIX_AI_ALLOW_ANONYMOUS=0
AURIX_AI_TIMEOUT_SECONDS=60
AURIX_AI_MAX_OUTPUT_TOKENS=1200
AURIX_AI_MAX_REQUESTS_PER_MINUTE=20
AURIX_AI_SESSION_MAX_AGE_SECONDS=2592000
AURIX_AI_SESSION_DB_PATH=/var/lib/aurix-ai/sessions.db
AURIX_AI_API_KEYS_DB_PATH=/var/lib/aurix-ai/api-keys.db
AURIX_AI_DATABASE_URL=
AURIX_AI_ADMIN_TOKEN=
AURIX_AI_MODEL_CATALOG_TTL_SECONDS=60
AURIX_TELEGRAM_BOT_USERNAME=aurix_outline_vpn_bot
