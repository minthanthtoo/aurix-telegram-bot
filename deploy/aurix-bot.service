[Unit]
Description=AuriX Telegram paid-concierge bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurix
Group=aurix
WorkingDirectory=/opt/aurix-bot
EnvironmentFile=/etc/aurix-bot/aurix.env
ExecStart=/opt/aurix-venv/bin/python /opt/aurix-bot/app.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurix-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
