[Unit]
Description=AuriX Telegram VPN bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurix
Group=aurix
WorkingDirectory=/opt/aurix-current
EnvironmentFile=/etc/aurix-bot/aurix.env
ExecStart=/opt/aurix-current/.venv/bin/python -u /opt/aurix-current/app.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/aurix-bot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
