# The 9Router service is reachable on the existing private Docker network.
AURIX_AI_ROUTER_BASE_URL=http://9router:20128
AURIX_AI_ROUTER_API_KEY=replace-with-9router-api-key
# Verified 2026-09-09 through the live 9Router API.
AURIX_AI_MODEL=ag/gemini-3.7-flash-high

# Legacy migration-only token. Keep disabled below after Telegram auth is live.
AURIX_AI_ACCESS_TOKEN=replace-with-aurix-ai-access-token
AURIX_AI_LEGACY_TOKEN_ENABLED=0
AURIX_AI_ALLOW_ANONYMOUS=0
AURIX_AI_TIMEOUT_SECONDS=60
AURIX_AI_MAX_OUTPUT_TOKENS=1200
AURIX_AI_MAX_REQUESTS_PER_MINUTE=20
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
AURIX_TELEGRAM_BOT_USERNAME=aurix_outline_vpn_bot
AURIX_AI_SESSION_MAX_AGE_SECONDS=86400
# Reuse the existing AuriX Telegram admin allowlist for browser admin reports.
ADMIN_TELEGRAM_IDS=
# Persistent AuriX account/key registry for backend integrations. Leave empty
# to keep /v1/chat disabled until its data directory is mounted and provisioned.
AURIX_AI_API_KEYS_DB_PATH=/var/lib/aurix-ai/api-keys.db
# For production, point this at the existing AuriX COMMERCE_DATABASE_URL. The
# AI tables use component-scoped migrations and do not modify 9Router tables.
# Set this explicitly; it is not inferred from the bot environment.
AURIX_AI_DATABASE_URL=
# Separate operator/admin bearer token for usage reports; never give this to sites.
AURIX_AI_ADMIN_TOKEN=replace-with-a-long-random-admin-token
