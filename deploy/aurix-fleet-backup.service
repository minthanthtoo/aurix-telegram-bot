[Unit]
Description=Encrypt and retain AuriX Outline fleet state backups
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/aurix-current
EnvironmentFile=/etc/aurix-bot/aurix.env
ExecStart=/opt/aurix-current/.venv/bin/python deploy/fleet_backup.py backup --node all --env-file /etc/aurix-bot/aurix.env
TimeoutStartSec=30min
Nice=15

