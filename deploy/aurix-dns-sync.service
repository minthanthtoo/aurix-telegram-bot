[Unit]
Description=Reconcile opt-in AuriX fleet DNS records
After=network-online.target aurix-fleet-reconcile.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/aurix-current
EnvironmentFile=/etc/aurix-bot/aurix.env
ExecStart=/opt/aurix-current/.venv/bin/python deploy/dns_sync_worker.py --env-file /etc/aurix-bot/aurix.env
TimeoutStartSec=5min
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurix-dns-sync

