[Unit]
Description=AuriX authenticated fleet probe API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurix
Group=aurix
WorkingDirectory=/opt/aurix-current
EnvironmentFile=/etc/aurix-bot/aurix.env
ExecStart=/opt/aurix-current/.venv/bin/python /opt/aurix-current/deploy/fleet_probe_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurix-bot

[Install]
WantedBy=multi-user.target
